# ── Needed for the day-to-day curation tool (npm run server) ──────────────────
# The web UI itself runs with no keys at all; these unlock the features noted.

# GitHub Personal Access Token with repo read access to hit-pay/hitpay-core
# (and hit-pay/hitpay-android, hit-pay/hitpay-ios for mobile).
# Used by: pulling new releases (npm run analyze:new, the weekly auto-pull), enrich.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (openrouter.ai/keys).
# Used by: extracting features from releases, enriching descriptions, ✨ Suggest CTA.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Optional: web UI port (default 3001)
# PORT=3001

# ── Only for the dormant automated pipeline (src/index.ts) — safe to leave as-is ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LOOPS_API_KEY=xxxxxxxxxxxxxxxxxxxx
LOOPS_TRANSACTIONAL_ID=xxxxxxxxxxxxxxxx
DRY_RUN=false
